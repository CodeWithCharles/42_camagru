@model EmptyGalleryViewModel
@{
    ViewData["Title"] = "Gallery Empty";
    ViewData["PageId"] = "gallery";
}

<section class="o-container p-gallery__empty">
    <article class="c-card c-card--hero">
        <span class="c-eyebrow">Empty Gallery</span>
        <h1>No public montages yet</h1>
        <p>This environment is ready, but there are no saved public posts to display. The empty state is wired on purpose so the frontend stays coherent before data appears.</p>
        <div class="c-card__actions">
            <a class="c-button c-button--primary" href="@Model.PrimaryActionUrl">@Model.PrimaryActionText</a>
            <a class="c-button c-button--ghost" href="@Model.SecondaryActionUrl">@Model.SecondaryActionText</a>
        </div>
    </article>
</section>
