@model ForgotPasswordPageViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["PageId"] = "auth";
}

<partial name="~/Views/Shared/Forms/_AuthCard.cshtml" model='new AuthCardViewModel
{
    Eyebrow = "Recovery Link",
    Title = "Request a password reset",
    Intro = "Enter the email attached to your account and Camagru will stage a reset link if the address exists.",
    FormPartialPath = "~/Views/Auth/Partials/_ForgotPasswordForm.cshtml",
    FormModel = Model,
    SecondaryHint = "Remembered it after all?",
    SecondaryLinkText = "Back to login",
    SecondaryLinkUrl = Url.Action("Login", "Auth") ?? "/Auth/Login",
    AsideTitle = "Security behavior",
    AsidePoints = new[]
    {
        "This flow does not reveal whether an email exists in the system.",
        "Reset tokens expire and surface a dedicated invalid-token state.",
        "Final password changes are wired to the existing Application use case."
    }
}' />
