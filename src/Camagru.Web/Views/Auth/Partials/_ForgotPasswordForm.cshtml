@model ForgotPasswordPageViewModel

<form asp-action="ForgotPassword" method="post" class="c-form c-form--stack">
    @Html.AntiForgeryToken()
    <partial name="~/Views/Shared/Forms/_ValidationSummary.cshtml" />

    <div class="c-field">
        <label asp-for="Form.Email" class="c-field__label"></label>
        <input asp-for="Form.Email" class="c-input" autocomplete="email" />
        <span asp-validation-for="Form.Email" class="c-field__error"></span>
    </div>

    <button type="submit" class="c-button c-button--primary c-button--block">Send reset link</button>
</form>
