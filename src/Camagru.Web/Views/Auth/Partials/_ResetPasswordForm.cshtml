@model ResetPasswordPageViewModel

<form asp-action="ResetPassword" method="post" class="c-form c-form--stack">
    @Html.AntiForgeryToken()
    <input asp-for="Form.Token" type="hidden" />
    <partial name="~/Views/Shared/Forms/_ValidationSummary.cshtml" />

    <div class="c-field">
        <label asp-for="Form.NewPassword" class="c-field__label"></label>
        <div class="c-password-input">
            <input asp-for="Form.NewPassword" class="c-input" autocomplete="new-password" />
            <button type="button" class="c-button c-button--icon" data-password-toggle data-target="Form_NewPassword">Show</button>
        </div>
        <span asp-validation-for="Form.NewPassword" class="c-field__error"></span>
    </div>

    <div class="c-field">
        <label asp-for="Form.ConfirmNewPassword" class="c-field__label"></label>
        <div class="c-password-input">
            <input asp-for="Form.ConfirmNewPassword" class="c-input" autocomplete="new-password" />
            <button type="button" class="c-button c-button--icon" data-password-toggle data-target="Form_ConfirmNewPassword">Show</button>
        </div>
        <span asp-validation-for="Form.ConfirmNewPassword" class="c-field__error"></span>
    </div>

    <button type="submit" class="c-button c-button--primary c-button--block">Reset password</button>
</form>
