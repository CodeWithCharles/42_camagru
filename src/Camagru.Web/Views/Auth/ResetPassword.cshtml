@model ResetPasswordPageViewModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["PageId"] = "auth";
}

@if (!Model.IsTokenValid)
{
    <section class="p-auth__single">
        <article class="c-card c-card--auth">
            <span class="c-eyebrow">Token Invalid</span>
            <h1>Reset link unavailable</h1>
            <p>@Model.TokenStateMessage</p>
            <div class="c-card__actions">
                <a class="c-button c-button--primary" asp-action="ForgotPassword">Request a new link</a>
                <a class="c-button c-button--ghost" asp-action="Login">Back to login</a>
            </div>
        </article>
    </section>
}
else
{
    <partial name="~/Views/Shared/Forms/_AuthCard.cshtml" model='new AuthCardViewModel
    {
        Eyebrow = "Credential Reset",
        Title = "Set a new password",
        Intro = "Choose a strong replacement and complete the recovery flow.",
        FormPartialPath = "~/Views/Auth/Partials/_ResetPasswordForm.cshtml",
        FormModel = Model,
        SecondaryHint = "Need another link instead?",
        SecondaryLinkText = "Request reset email",
        SecondaryLinkUrl = Url.Action("ForgotPassword", "Auth") ?? "/Auth/ForgotPassword",
        AsideTitle = "Password guidance",
        AsidePoints = new[]
        {
            "Use at least 8 characters with uppercase, lowercase, and digits.",
            "Invalid or expired tokens fall back to a dedicated recovery state.",
            "Success redirects you back to login with a confirmation toast."
        }
    }' />
}
