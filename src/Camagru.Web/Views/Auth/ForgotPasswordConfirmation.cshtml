@model ForgotPasswordConfirmationViewModel
@{
    ViewData["Title"] = "Check Your Email";
    ViewData["PageId"] = "auth";
}

<section class="p-auth__single">
    <article class="c-card c-card--auth">
        <span class="c-eyebrow">Recovery Routed</span>
        <h1>Check your inbox</h1>
        <p>If the address exists in Camagru, the reset link is already on the way.</p>

        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <partial name="~/Views/Shared/Forms/_FormField.cshtml" model="new FormFieldViewModel
            {
                Label = \"Requested address\",
                Name = \"requested-email\",
                Value = Model.Email!,
                ReadOnly = true
            }" />
        }

        <div class="c-card__actions">
            <a class="c-button c-button--primary" asp-action="Login">Back to login</a>
            <a class="c-button c-button--ghost" asp-controller="Gallery" asp-action="Index">Open gallery</a>
        </div>
    </article>
</section>
