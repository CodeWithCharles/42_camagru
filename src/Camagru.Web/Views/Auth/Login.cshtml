@model LoginPageViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["PageId"] = "auth";
}

<partial name="~/Views/Shared/Forms/_AuthCard.cshtml" model="new AuthCardViewModel
{
    Eyebrow = \"Auth Relay\",
    Title = \"Return to the control room\",
    Intro = \"Authenticate with your Camagru identity to access the editor, profile management, and interaction controls.\",
    FormPartialPath = \"~/Views/Auth/Partials/_LoginForm.cshtml\",
    FormModel = Model,
    SecondaryHint = \"Need a fresh account?\",
    SecondaryLinkText = \"Register\",
    SecondaryLinkUrl = Url.Action(\"Register\", \"Auth\") ?? \"/Auth/Register\",
    AsideTitle = \"Session notes\",
    AsidePoints = new[]
    {
        \"Unconfirmed accounts stay blocked until the email link is validated.\",
        \"Return URLs bring you back to the editor or profile after sign-in.\",
        \"Logout is always available in the top navigation.\"
    }
}" />
