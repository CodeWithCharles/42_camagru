@model StatusPageViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageId"] = "status";
}

<section class="o-container p-status">
    <article class="c-card c-card--hero">
        <span class="c-eyebrow">Feature Placeholder</span>
        <h1>@Model.Headline</h1>
        <p>@Model.Description</p>

        @if (!string.IsNullOrWhiteSpace(Model.FeatureName))
        {
            <div class="c-inline-alert">
                <strong>Feature:</strong>
                <span>@Model.FeatureName</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.MissingContractName))
        {
            <div class="c-inline-alert c-inline-alert--warning">
                <strong>Missing Application contract:</strong>
                <code>@Model.MissingContractName</code>
            </div>
        }

        <div class="c-card__actions">
            <a class="c-button c-button--primary" href="@Model.PrimaryActionUrl">@Model.PrimaryActionText</a>
            @if (!string.IsNullOrWhiteSpace(Model.SecondaryActionText) && !string.IsNullOrWhiteSpace(Model.SecondaryActionUrl))
            {
                <a class="c-button c-button--ghost" href="@Model.SecondaryActionUrl">@Model.SecondaryActionText</a>
            }
        </div>
    </article>
</section>
