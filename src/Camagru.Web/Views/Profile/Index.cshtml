@model ProfilePageViewModel
@{
    ViewData["Title"] = "Profile";
    ViewData["PageId"] = "profile";
    ViewData["ActiveSection"] = Model.ActiveSection;
}

<section class="o-container p-profile">
    <header class="p-profile__hero">
        <article class="c-card c-card--hero">
            <span class="c-eyebrow">Account Deck</span>
            <h1>@Model.Summary.DisplayName</h1>
            <p class="p-profile__handle">@("@" + Model.Summary.Username)</p>
            @if (!string.IsNullOrWhiteSpace(Model.Summary.Bio))
            {
                <p>@Model.Summary.Bio</p>
            }
            else
            {
                <p>No bio configured yet. Update the identity panel below to personalize this account.</p>
            }
            <div class="p-profile__stats">
                <div>
                    <strong>@Model.Summary.PostCount</strong>
                    <span>posts</span>
                </div>
                <div>
                    <strong>@Model.Summary.CreatedAt.ToString("MMMM yyyy")</strong>
                    <span>member since</span>
                </div>
                <div>
                    <strong>@(Model.Summary.EmailNotificationsEnabled ? "ON" : "OFF")</strong>
                    <span>comment emails</span>
                </div>
            </div>
        </article>

        <article class="c-card c-card--hud">
            <span class="c-eyebrow">Identity Snapshot</span>
            <h2>Current account values</h2>
            <partial name="~/Views/Shared/Forms/_FormField.cshtml" model="new FormFieldViewModel
            {
                Label = \"Email\",
                Name = \"summary-email\",
                Value = Model.Summary.Email,
                ReadOnly = true
            }" />
            <partial name="~/Views/Shared/Forms/_FormField.cshtml" model="new FormFieldViewModel
            {
                Label = \"Display name\",
                Name = \"summary-display-name\",
                Value = Model.Summary.DisplayName,
                ReadOnly = true
            }" />
        </article>
    </header>

    <div class="p-profile__layout">
        <section id="identity" class="c-card p-profile__panel" data-profile-section="identity">
            <div class="p-profile__panel-header">
                <span class="c-eyebrow">Identity</span>
                <h2>Update username and bio</h2>
            </div>

            <form asp-action="UpdateDetails" method="post" class="c-form c-form--stack">
                @Html.AntiForgeryToken()
                <partial name="~/Views/Shared/Forms/_ValidationSummary.cshtml" />
                <input asp-for="Details.CurrentEmail" type="hidden" />

                <div class="c-field">
                    <label asp-for="Details.Username" class="c-field__label"></label>
                    <input asp-for="Details.Username" class="c-input" />
                    <span asp-validation-for="Details.Username" class="c-field__error"></span>
                </div>

                <div class="c-field">
                    <label asp-for="Details.DisplayName" class="c-field__label"></label>
                    <input asp-for="Details.DisplayName" class="c-input" />
                    <span asp-validation-for="Details.DisplayName" class="c-field__error"></span>
                </div>

                <div class="c-field">
                    <label asp-for="Details.Bio" class="c-field__label"></label>
                    <textarea asp-for="Details.Bio" class="c-input c-input--multiline" rows="5"></textarea>
                    <span asp-validation-for="Details.Bio" class="c-field__error"></span>
                </div>

                <button type="submit" class="c-button c-button--primary">Save identity</button>
            </form>
        </section>

        <section id="security" class="c-card p-profile__panel" data-profile-section="security">
            <div class="p-profile__panel-header">
                <span class="c-eyebrow">Security</span>
                <h2>Change email and password</h2>
            </div>

            <div class="p-profile__double-stack">
                <form asp-action="ChangeEmail" method="post" class="c-form c-form--stack">
                    @Html.AntiForgeryToken()
                    <h3>Change email</h3>
                    <partial name="~/Views/Shared/Forms/_ValidationSummary.cshtml" />

                    <div class="c-field">
                        <label asp-for="EmailChange.CurrentPassword" class="c-field__label"></label>
                        <input asp-for="EmailChange.CurrentPassword" class="c-input" autocomplete="current-password" />
                        <span asp-validation-for="EmailChange.CurrentPassword" class="c-field__error"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="EmailChange.NewEmail" class="c-field__label"></label>
                        <input asp-for="EmailChange.NewEmail" class="c-input" autocomplete="email" />
                        <span asp-validation-for="EmailChange.NewEmail" class="c-field__error"></span>
                    </div>

                    <button type="submit" class="c-button c-button--ghost">Update email</button>
                </form>

                <form asp-action="ChangePassword" method="post" class="c-form c-form--stack">
                    @Html.AntiForgeryToken()
                    <h3>Change password</h3>
                    <partial name="~/Views/Shared/Forms/_ValidationSummary.cshtml" />

                    <div class="c-field">
                        <label asp-for="PasswordChange.CurrentPassword" class="c-field__label"></label>
                        <input asp-for="PasswordChange.CurrentPassword" class="c-input" autocomplete="current-password" />
                        <span asp-validation-for="PasswordChange.CurrentPassword" class="c-field__error"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="PasswordChange.NewPassword" class="c-field__label"></label>
                        <input asp-for="PasswordChange.NewPassword" class="c-input" autocomplete="new-password" />
                        <span asp-validation-for="PasswordChange.NewPassword" class="c-field__error"></span>
                    </div>

                    <div class="c-field">
                        <label asp-for="PasswordChange.ConfirmNewPassword" class="c-field__label"></label>
                        <input asp-for="PasswordChange.ConfirmNewPassword" class="c-input" autocomplete="new-password" />
                        <span asp-validation-for="PasswordChange.ConfirmNewPassword" class="c-field__error"></span>
                    </div>

                    <button type="submit" class="c-button c-button--ghost">Update password</button>
                </form>
            </div>
        </section>

        <section id="preferences" class="c-card p-profile__panel" data-profile-section="preferences">
            <div class="p-profile__panel-header">
                <span class="c-eyebrow">Preferences</span>
                <h2>Notification routing</h2>
            </div>

            <form asp-action="UpdatePreferences" method="post" class="c-form c-form--stack">
                @Html.AntiForgeryToken()
                <label class="c-toggle">
                    <input asp-for="Preferences.EmailNotificationsEnabled" />
                    <span class="c-toggle__track"></span>
                    <span class="c-toggle__copy">Email me when a new comment lands on one of my posts.</span>
                </label>
                <button type="submit" class="c-button c-button--primary">Save preferences</button>
            </form>
        </section>

        <section class="c-card p-profile__panel">
            <div class="p-profile__panel-header">
                <span class="c-eyebrow">Recent Posts</span>
                <h2>Your latest public captures</h2>
            </div>

            @if (Model.RecentPosts.Count > 0)
            {
                <div class="p-profile__post-grid">
                    @foreach (var post in Model.RecentPosts)
                    {
                        <a class="c-card c-card--thumb p-profile__post-link"
                           asp-controller="Gallery"
                           asp-action="Index"
                           asp-route-postId="@post.PostId">
                            <img src="@post.ImageUrl" alt="Post @post.PostId" />
                            <div>
                                <strong>@post.CreatedLabel</strong>
                                <p>@post.Description</p>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="c-empty-state">
                    <strong>No posts published yet</strong>
                    <p>The editor is ready for preview exports, and the public gallery will light up once persistence is wired.</p>
                </div>
            }
        </section>

        <section id="danger" class="c-card c-card--danger p-profile__panel" data-profile-section="danger">
            <div class="p-profile__panel-header">
                <span class="c-eyebrow">Danger Zone</span>
                <h2>Delete account</h2>
            </div>

            <form asp-action="DeleteAccount" method="post" class="c-form c-form--stack">
                @Html.AntiForgeryToken()
                <p>This action removes your account and associated content. The UI enforces ownership, and the use case performs the deletion.</p>

                <div class="c-field">
                    <label asp-for="DeleteAccount.Password" class="c-field__label"></label>
                    <input asp-for="DeleteAccount.Password" class="c-input" autocomplete="current-password" />
                    <span asp-validation-for="DeleteAccount.Password" class="c-field__error"></span>
                </div>

                <button type="submit" class="c-button c-button--danger">Delete account</button>
            </form>
        </section>
    </div>
</section>
