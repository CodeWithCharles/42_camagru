<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="~/Views/Shared/Partials/_Head.cshtml" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="app-shell @(User.Identity?.IsAuthenticated ?? false ? "app-shell--authenticated" : "app-shell--guest")"
      data-page="@(ViewData["PageId"] ?? "shell")"
      data-active-section="@(ViewData["ActiveSection"] ?? string.Empty)">
    <div class="app-shell__veil" aria-hidden="true"></div>
    <partial name="~/Views/Shared/Partials/_Nav.cshtml" />
    <partial name="~/Views/Shared/Partials/_Toasts.cshtml" />

    <main class="app-shell__main">
        @RenderBody()
    </main>

    <partial name="~/Views/Shared/Partials/_Footer.cshtml" />

    <script type="module" src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
