@model IReadOnlyList<StickerGroupViewModel>

<section class="c-card c-card--hud p-editor__tool-panel">
    <div class="p-editor__panel-header">
        <span class="c-eyebrow">Overlay Picker</span>
        <h2>Starter stickers</h2>
        <p>Click a transparent PNG to add it to the stage. Every overlay remains editable locally.</p>
    </div>

    <div class="p-editor__group-list">
        @foreach (var group in Model)
        {
            <section class="p-editor__group">
                <header>
                    <strong>@group.Title</strong>
                    <p>@group.Description</p>
                </header>

                <div class="p-editor__sticker-grid">
                    @foreach (var sticker in group.Stickers)
                    {
                        <button type="button"
                                class="c-card c-card--sticker"
                                data-sticker-button
                                data-sticker-id="@sticker.Id"
                                data-overlay-id="@sticker.OverlayId"
                                data-sticker-name="@sticker.Name"
                                data-sticker-src="@sticker.ImageUrl"
                                data-sticker-accent="@sticker.Accent">
                            <img src="@sticker.ImageUrl" alt="@sticker.Name sticker" />
                            <span>@sticker.Name</span>
                        </button>
                    }
                </div>
            </section>
        }
    </div>
</section>
